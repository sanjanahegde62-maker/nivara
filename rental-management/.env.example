# =============================================================================
# .env.example — copy this file to .env and fill in the required values.
#
# The .env file is gitignored.  NEVER commit real credentials.
# =============================================================================

# PostgreSQL credentials (used by both the db and app services)
DB_USERNAME=postgres
DB_PASSWORD=change_me_before_use

# JWT signing key — must be at least 32 characters (HMAC-SHA256 requirement).
# Generate a strong value, for example:
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# JWT token expiration in milliseconds (optional; defaults to 3600000 = 1 hour)
# JWT_EXPIRATION=3600000
